# ---------------------------------------------------------------------------
# NoClue Industries — environment configuration
# Copy to .env for local development. In Coolify, set these as environment
# variables on the application (mark secrets as "secret"). Never commit .env.
# ---------------------------------------------------------------------------

# Public base URL (no trailing slash). Used for canonical URLs, sitemap, CORS/CSRF.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# PostgreSQL connection string.
#   dev (docker-compose.dev.yml): postgres://noclue:noclue-dev@127.0.0.1:5433/noclue_industries
#   prod (docker-compose.yml):    postgres://noclue:${POSTGRES_PASSWORD}@db:5432/noclue_industries
DATABASE_URL=postgres://noclue:noclue-dev@127.0.0.1:5433/noclue_industries

# Long random string (e.g. `openssl rand -hex 32`). Signs admin sessions.
PAYLOAD_SECRET=change-me

# Where uploaded media is stored when S3 is NOT configured (local disk / Docker volume).
MEDIA_DIR=media

# --- Object storage: Garage (S3-compatible), see docs/STORAGE.md --------------
# Public base URL of the asset bucket (Garage web endpoint). Renders, photography,
# the assembly sequence and CMS uploads are loaded from here. Empty = /public (dev).
ASSET_URL=
# S3 API of Garage. When all four are set, CMS uploads go to S3_BUCKET/media/.
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private bucket for the source archive (`pnpm assets:upload --source` only).
S3_SOURCE_BUCKET=

# Secret salt for hashing visitor IPs in inquiry abuse protection (`openssl rand -hex 16`).
INQUIRY_IP_SALT=change-me

# --- Email notifications for new inquiries (optional) -----------------------
# Without SMTP_HOST, inquiries are still stored in the CMS and marked
# "Email not configured" — nothing pretends to have been delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@noclue.industries
SMTP_FROM_NAME=NoClue Industries
# Comma-separated recipients. Overridden by "Notify emails" in Site settings when set there.
INQUIRY_NOTIFY_TO=

# --- Optional Cloudflare Turnstile ------------------------------------------
# When both are set, the inquiry form requires a Turnstile token.
# If you enable it, add Turnstile to the privacy notice (Pages → privacy).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
